{
  "name": "rapidscan-api",
  "version": "1.0.0",
  "description": "RapidScan Azure Functions API",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "func start",
    "prestart": "npm run build",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@octokit/rest": "^20.0.0",
    "busboy": "^1.6.0",
    "mssql": "^12.5.0",
    "multer": "1.4.5-lts.1",
    "node-unrar-js": "^2.0.2",
    "openai": "^4.0.0",
    "unzipper": "^0.10.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/jest": "^30.0.0",
    "@types/mssql": "^9.0.0",
    "@types/node": "^18.0.0",
    "@types/unzipper": "^0.10.0",
    "azure-functions-core-tools": "^4.10.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0"
  }
}
